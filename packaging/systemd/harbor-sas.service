[Unit]
Description=harbor-sas control plane (scheduler + webhooks + dashboard)
After=network.target

[Service]
Type=simple
EnvironmentFile=-/etc/harbor-sas.env
ExecStart=__HARBOR_VENV_BIN__ serve --data-dir __HARBOR_DATA_DIR__ --executor __HARBOR_EXECUTOR__
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
